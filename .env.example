# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

API_PORT=4000
SUPER_ADMIN_PORT=3001
ERP_PORT=3000

CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

NEXT_PUBLIC_API_URL="http://localhost:4000"

# Requests per minute per IP (spec §73). Auth routes are stricter regardless.
RATE_LIMIT_PER_MINUTE=300

# AI insights (spec §§69–71) — OPTIONAL.
# Insight *findings* are computed from the database and work without this. The
# key only enables the written summary that accompanies them: leave it unset and
# the product reports the same findings, without prose. It never invents numbers.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL="claude-opus-5"
